# ============ 复制为 .env 后按需修改；.env 不提交 ============

# ---------- Django ----------
DJANGO_SECRET_KEY=dev-only-change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---------- 数据库 ----------
# 第一次先跑 sqlite，不需要安装任何数据库软件；团队环境统一后再改成 postgres
DB_ENGINE=sqlite
# DB_ENGINE=postgres
DB_NAME=smartworks
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# ---------- 前端（frontend/.env.development 里也有一份） ----------
VITE_API_BASE=/api/v1
